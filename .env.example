# Example only. Set the real values in Cloudflare Workers > Settings > Variables and Secrets.
# Do not commit or share real values.
DISCORD_APPLICATION_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_PUBLIC_KEY=YOUR_DISCORD_PUBLIC_KEY
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
SETUP_KEY=YOUR_LONG_RANDOM_SETUP_KEY
# Optional overrides:
BLR_8V8_PLACE_ID=124087144919678
BLR_PRO_PLACE_ID=99999183305180
ROBLOX_MAX_PAGES=3
ROVALRA_REGIONS_ENABLED=true
# Optional TikTok /download media processor (same token in both services):
TIKTOK_SERVICE_URL=https://your-media-service.example
TIKTOK_SERVICE_TOKEN=YOUR_LONG_RANDOM_MEDIA_SERVICE_SECRET
